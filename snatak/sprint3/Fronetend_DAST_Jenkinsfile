pipeline {
    agent any

    environment {
        TARGET_URL = 'http://52.66.253.129'
        ZAP_PORT = '8099'
        ZAP_API_KEY = 'dastkey'
    }

    stages {

        stage('DAST Scan') {
            steps {
                sh '''
                set -ex

                # Cleanup
                pkill -f zap || true
                rm -rf java zap

                # Download JDK
                mkdir java
                cd java
                wget -q https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.12+7/OpenJDK17U-jdk_x64_linux_hotspot_17.0.12_7.tar.gz
                tar -xzf OpenJDK17U-jdk_x64_linux_hotspot_17.0.12_7.tar.gz
                cd ..

                JAVA_HOME=$(find java -maxdepth 1 -type d -name "jdk-17*" | head -1)
                export JAVA_HOME="$PWD/$JAVA_HOME"
                export PATH="$JAVA_HOME/bin:$PATH"

                java -version

                # Install jq if missing
                if ! command -v jq >/dev/null 2>&1; then
                    sudo apt-get update
                    sudo apt-get install -y jq
                fi

                # Download ZAP
                mkdir zap
                cd zap
                wget -q https://github.com/zaproxy/zaproxy/releases/download/v2.17.0/ZAP_2.17.0_Linux.tar.gz
                tar -xzf ZAP_2.17.0_Linux.tar.gz
                cd ..

                ZAP_PATH=$(find zap -name zap.sh | head -1)
                chmod +x "$ZAP_PATH"

                # Start ZAP
                BUILD_ID=dontKillMe nohup "$ZAP_PATH" \
                    -daemon \
                    -host 0.0.0.0 \
                    -port $ZAP_PORT \
                    -config api.key=$ZAP_API_KEY \
                    -config api.addrs.addr.name=.* \
                    -config api.addrs.addr.regex=true \
                    > zap.log 2>&1 &

                echo "Waiting for ZAP..."

                until curl -sf http://127.0.0.1:$ZAP_PORT/JSON/core/view/version/ >/dev/null
                do
                    sleep 2
                done

                echo "ZAP Started"

                # Spider Scan
                SCAN_ID=$(curl -s \
                "http://127.0.0.1:$ZAP_PORT/JSON/spider/action/scan/?apikey=$ZAP_API_KEY&url=$TARGET_URL" \
                | jq -r '.scan')

                while true
                do
                    STATUS=$(curl -s \
                    "http://127.0.0.1:$ZAP_PORT/JSON/spider/view/status/?apikey=$ZAP_API_KEY&scanId=$SCAN_ID" \
                    | jq -r '.status')

                    echo "Spider: $STATUS%"

                    [ "$STATUS" = "100" ] && break
                    sleep 5
                done

                # Active Scan
                ASCAN=$(curl -s \
                "http://127.0.0.1:$ZAP_PORT/JSON/ascan/action/scan/?apikey=$ZAP_API_KEY&url=$TARGET_URL" \
                | jq -r '.scan')

                while true
                do
                    STATUS=$(curl -s \
                    "http://127.0.0.1:$ZAP_PORT/JSON/ascan/view/status/?apikey=$ZAP_API_KEY&scanId=$ASCAN" \
                    | jq -r '.status')

                    echo "Active Scan: $STATUS%"

                    [ "$STATUS" = "100" ] && break
                    sleep 10
                done

                # Generate Report
                curl -s \
                "http://127.0.0.1:$ZAP_PORT/OTHER/core/other/htmlreport/?apikey=$ZAP_API_KEY" \
                > zap_report.html
                '''
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'zap_report.html,zap.log', allowEmptyArchive: true

            sh '''
            pkill -f zap || true
            rm -rf java zap
            '''
        }

        success {
            echo "DAST Scan Completed Successfully"
        }

        failure {
            echo "DAST Scan Failed"
        }
    }
}
